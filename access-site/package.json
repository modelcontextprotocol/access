{
  "name": "@mcp/access-site",
  "version": "0.1.0",
  "private": true,
  "description": "access.modelcontextprotocol.io: GitHub sign-in (OIDC) and self-service Google Workspace accounts for MCP maintainers",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "migrate": "wrangler d1 migrations apply access-site --remote",
