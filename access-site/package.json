    "test": "vitest run",
    "generate-keys": "node scripts/generate-keys.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@hono/oauth-providers": "^0.9.0",
    "hono": "^4.13.13",
    "jose": "^6.2.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261024.1",
    "typescript": "^5.9.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}
